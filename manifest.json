{
  "manifest_version": 3,
  "name": "PinTube - YouTube Video Pinner & Focus Suite",
  "version": "1.0.0",
  "description": "Pin your favorite YouTube videos to your home feed, use Focus Mode to remove feed distractions, and hide Shorts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PinTube - Pinned YouTube Videos & Focus Suite"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": [
        "content/modules/endscreen.css",
        "content/modules/focus-mode.css",
        "content/modules/shelf.css"
      ],
      "js": [
        "content/modules/state.js",
        "content/modules/metadata.js",
        "content/modules/overlay.js",
        "content/modules/pin-actions.js",
        "content/modules/shelf.js",
        "content/modules/scanner.js",
        "content/modules/observer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ]
}
